{
  "name": "ashu-paybox-fcm-test-sender",
  "version": "1.0.0",
  "description": "Local PC developer tool to send FCM payment test payloads to Ashu PayBox Android app",
  "main": "send-payment-test.js",
  "bin": {
    "send-payment-test": "./send-payment-test.js"
  },
  "scripts": {
    "test-35": "node send-payment-test.js --amount 35",
    "test-300": "node send-payment-test.js --amount 300",
    "test-duplicate": "node send-payment-test.js --amount 35 --duplicate",
    "test-burst": "node send-payment-test.js --burst 10"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0"
  }
}
